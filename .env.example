# Copy to `.env` and fill in MASTER_SIGNING_SECRET before running.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/hookvault.sqlite
HOOKVAULT_TIER=free
MASTER_SIGNING_SECRET=
DELIVERY_TIMEOUT_MS=10000
MAX_DELIVERY_ATTEMPTS=3
NODE_ENV=development

# Only set this if you intentionally bind HOST to 0.0.0.0 behind your own
# reverse proxy / auth. The Free-tier management API is otherwise open.
# HOOKVAULT_ALLOW_REMOTE=1
